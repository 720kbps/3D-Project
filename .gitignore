# Build directories
/build/
/cmake-build-*/
out/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json
# Do NOT add *.cmake here: framework/cmake/*.cmake and the third_party CMake modules are
# source files that the build needs. Generated .cmake files only live in the build dirs above.

# Compiled binaries and objects
# (No *.obj or *.bin: those are also 3D model formats (Wavefront OBJ, glTF buffers) that we
#  load from resources/. Compiler object files only appear in the build dirs above.)
*.o
*.a
*.so
*.dylib
*.dll
*.exe
*.out
*.app

# IDE and editor files
.idea/
.vscode/
imgui.ini
*.swp
*.swo
*~

# OS metadata
.DS_Store
Thumbs.db

# Planning notes (not part of hand-in)
/battle-plan.html
